# Variáveis do compose.coolify.yml. No Coolify, cadastre-as na aba "Environment Variables" do recurso.
# Para teste local: cp docker/coolify.env.example docker/coolify.env (arquivo ignorado pelo Git) e troque TODOS os valores.
# Gere segredos com: openssl rand -hex 32

# URL pública (usada nos links das fotos e no CORS). Local: http://localhost:8088
APP_URL=http://localhost:8088

MYSQL_DATABASE=imob_hub
MYSQL_USER=imob_hub
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Cifra os dados pessoais das fichas de crédito. NÃO troque depois de ter dados: as fichas ficam ilegíveis.
APP_ENCRYPTION_KEY=troque-por-64-caracteres-hex-gerados-com-openssl-rand
WEBHOOK_TOKEN=troque-este-token
CONNECTOR_INTERNAL_TOKEN=
APP_TIMEZONE=America/Sao_Paulo
UPLOAD_MAX_BYTES=10485760

# Documenso (opcional; sem ele os contratos seguem pelo fluxo manual)
DOCUMENSO_URL=
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=

# Porta local do teste (docker/compose.local.yml)
WEB_PORT=8088
